# Created by .gitignore support plugin (hsz.mobi)
### Node template
# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directory
# Commenting this out is preferred by some people, see
# https://www.npmjs.org/doc/misc/npm-faq.html#should-i-check-my-node_modules-folder-into-git-
node_modules

# Users Environment Variables
.lock-wscript

.idea
# transient test artifacts
node_modules/
scratch-*
_t3d_test.js

# tools/headshot.mjs render output
.headshots/

# CMU mocap source files (tools/mocap/fetch.mjs re-downloads them on demand;
# the retargeted clips in tools/motion/ are what the build actually reads)
tools/mocap/cache/
.smoke/
# …and the same for the mobile control red team's shots. `npm run touch`
# rewrites all five every run, they are a megabyte each, and they are a
# rendering of the current tree rather than an input to it.
.touch/

# Studio Ochi SOURCE assets — the FBX and its atlas — are licensed and stay out
# of the repo. What IS committed is the retargeted motion in tools/motion-ochi/,
# the five tools that build from them, and the finished, repainted, rerigged
# flagster/lib/ochiplayer.glb, which is the character the game ships and loads.
*.fbx
*.blend
tools/ochi/
