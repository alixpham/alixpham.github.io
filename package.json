{
  "name": "flagster",
  "private": true,
  "type": "module",
  "description": "Flagster \u2014 the site itself ships NO npm dependencies and has no build step (see CLAUDE.md). This manifest exists only so the verification harnesses in tools/ are reproducible: containers are ephemeral and their node_modules is gitignored, so without a declared devDependency every session had to hand-install Playwright before it could check anything in a browser.",
  "scripts": {
    "lint": "node tools/lint.mjs",
    "test": "node tools/ruletest.mjs",
    "stats": "node tools/simstats.mjs",
    "celebs": "node tools/celebcheck.mjs",
    "build:player": "node tools/build-player-glb.mjs",
    "pulls": "node tools/pullstats.mjs",
    "pursuit": "node tools/pursuitstats.mjs",
    "smoke": "node tools/smoke.mjs",
    "passes": "node tools/passstats.mjs",
    "qb": "node tools/qbstats.mjs",
    "ball": "node tools/ballcheck.mjs",
    "feet": "node tools/footcheck.mjs",
    "body": "node tools/bodycheck.mjs",
    "slip": "node tools/gaitslip.mjs",
    "pose": "node tools/posecheck.mjs",
    "hero": "node tools/herocheck.mjs",
    "touch": "node tools/touchcheck.mjs",
    "pick": "node tools/pickcheck.mjs",
    "audition": "node tools/clip-audition.mjs",
    "ochi:fetch": "node tools/ochi-fetch.mjs"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
